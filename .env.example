# AegisGov AI Environment Configuration
APP_NAME="AegisGov AI"
ENVIRONMENT="development"
DEBUG=True
PORT=8080
HOST="0.0.0.0"

# Google Cloud & Gemini Credentials
# Option A: Direct Gemini API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY="your-gemini-api-key-here"

# Option B: Vertex AI & Google Cloud Project
GCP_PROJECT_ID="aegisgov-ai-2026"
GCP_LOCATION="asia-southeast1" # Singapore region
# Designated Free-Tier Account (All deployments will be strictly locked to this account)
GCP_DEPLOY_ACCOUNT="your-gcp-email@gmail.com"

# Models
GEMINI_MODEL_FLASH="gemini-1.5-flash"
GEMINI_MODEL_PRO="gemini-1.5-pro"

# JAPAC Financial Thresholds
BASE_CURRENCY="SGD"
HIGH_VALUE_THRESHOLD_SGD=10000.00
HIGH_VALUE_THRESHOLD_INR=500000.00
